    highp vec2 texColor = vec2(texture(FontsTex1, vec3(_input.UV, float(_input.Texture))).xy);
    highp vec3 color = (_input.Color.xyz * texColor.x) + (FontsConstantsData.OutlineColor.xyz * texColor.y);
    highp float mainAlpha = texColor.x * _input.Color.w;
    highp float outlineAlpha = (texColor.y * FontsConstantsData.OutlineColor.w) * _input.Color.w;
    return vec4(color, mainAlpha + outlineAlpha);
}

