};

layout(std140) uniform FontsConstants
{
    highp mat4 TextMatrix;
    highp vec4 FontSettings;
    highp vec4 OutlineColor;
} FontsConstantsData;

uniform highp sampler2DArray FontsTex1;

layout(location = 0) in highp vec2 input_UV;
layout(location = 1) flat in uint input_Texture;
layout(location = 2) in highp vec4 input_Color;
layout(location = 0) out highp vec4 _entryPointOutput;

highp vec4 _main(PixelInputType _input)
{
    if (_input.Texture == 255u)
