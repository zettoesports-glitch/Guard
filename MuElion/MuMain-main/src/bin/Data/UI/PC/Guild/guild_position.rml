    <div id="btnType2" class="mu-button guild-position-type guild-position-type2"><span id="btnType2-label">Position 2</span></div>
    <div id="btnOk" class="mu-button guild-position-ok"><span id="btnOk-label">OK</span></div>
    <div id="btnCancel" class="mu-button guild-position-cancel"><span id="btnCancel-label">Cancel</span></div>
</div>
