<rml>
<head>
    <meta name="mu-design-Panel-Size" content="327 639"/>
    <meta name="mu-design-Panel-Reference" content="640 480"/>
    <meta name="mu-design-Panel-Initial" content="20 20"/>
    <title>Reconstructed Guild Create</title>
    <link type="text/rcss" href="../Common/common.rcss"/>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="guild_panel.rcss"/>
</head>
<body class="mu-modern-document guild-create">
<div id="panel" class="guild-panel">
    <div id="btnDrag" class="guild-drag"/>
    <div id="tfTitle" class="guild-title">Guild</div>
    <div id="btnClose" class="mu-button guild-close">X</div>

    <div id="mcInfo" class="guild-page">
        <div class="guild-heading">Create Guild</div>
        <div class="guild-help">Create a guild and design its 8 x 8 emblem.</div>
    </div>

    <div id="mcGuildMark" class="guild-page">
        <div id="tfGuildName" class="guild-label">Guild Name</div>
        <input id="tiGuildNameValue" class="guild-input" type="text"/>
        <div id="tfGuildMark" class="guild-label mark-label">Guild Mark</div>
        <div id="mcGuildMarkDraw" class="guild-mark-grid"/>
        <div id="tfGuildMarkColor" class="guild-label color-label">Color</div>
        <div id="guild-colors" class="guild-colors"/>
    </div>

    <div id="mcGuildCheck" class="guild-page">
        <div class="guild-heading">Confirm Guild</div>
        <div id="mcCheckGuildMark" class="guild-mark-grid guild-mark-preview"/>
        <div id="tfCheckGuildName" class="guild-label check-name-label">Name</div>
        <div id="tfCheckGuildNameValue" class="guild-value check-name"/>
        <div id="tfCheckGuildMaster" class="guild-value check-master"/>
    </div>

    <div id="btnPrev" class="mu-button guild-nav guild-prev"><span id="btnPrev-label">Back</span></div>
    <div id="btnNext" class="mu-button guild-nav guild-next"><span id="btnNext-label">Next</span></div>
    <div id="btnConfirm" class="mu-button guild-nav guild-confirm"><span id="btnConfirm-label">Create</span></div>
</div>
</body>
</rml>
