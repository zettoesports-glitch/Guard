body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: transparent;
    pointer-events: none;
    font-family: Arial;
}
#monsters, .monster, .monster-name, .hp,
.hp-background, .hp-track, .hp-fill {
    position: absolute;
    pointer-events: none;
}
#monsters {
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
}
.monster {
    width: 140px;
    height: 32px;
    margin-left: -70px;
}
.monster-name {
    left: 0px;
    top: 0px;
    width: 140px;
    height: 16px;
    line-height: 16px;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    color: #f2f2f2;
    font-size: 12px;
}
.hp {
    left: 20px;
    top: 18px;
    width: 100px;
    height: 8px;
}
.hp-background {
    left: 0px;
    top: 0px;
    width: 100px;
    height: 8px;
    background-color: #151515dd;
    border-width: 1px;
    border-color: #6a5f4a;
}
.hp-track {
    left: 2px;
    top: 2px;
    width: 96px;
    height: 4px;
    overflow: hidden;
    clip: always;
}
.hp-fill {
    left: 0px;
    top: 0px;
    width: 100%;
    height: 4px;
    background-color: #c94949;
}
.monster.target .monster-name {
    color: #ffd67a;
}
