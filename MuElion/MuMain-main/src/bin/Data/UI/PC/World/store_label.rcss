body { margin:0; width:100%; height:100%; overflow:hidden; font-family:Arial; font-size:12px; pointer-events:none; }
#player-name-layer { position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; }
.player-label { position:absolute; width:0; height:0; color:#fff; pointer-events:none; }
.normal-block { position:absolute; left:0; top:0; width:0; height:0; }
.name-stack { position:absolute; left:-100px; bottom:10px; width:200px; text-align:center; font-weight:bold; }
.name-line { display:block; position:relative; height:16px; line-height:16px; white-space:nowrap; font-effect:shadow(1px 1px #000000e5); }
.player-id { color:#c8dcff; } .hero .player-id { color:#c8ff00; } .caution .player-id { color:#ff963c; } .murderer-one .player-id { color:#ff501e; } .murderer-two .player-id { color:#ff0000; } .game-master .player-id { color:#64fafa; }
.guild-line { color:#e6e6ff; } .guild-friendly .guild-line { color:#c8ff00; } .guild-hostile .guild-line { color:#ff1e00; }
.gens-mark { position:absolute; right:100%; top:-37px; margin-right:10px; width:22px; height:22px; border-radius:11px; background-color:#664f18; color:#fff; }
.castle-mark { position:absolute; left:-19px; top:-70px; width:39px; height:38px; border-width:1px; border-color:#c8a84f; }
.store-label { display:none; position:absolute; box-sizing:border-box; padding:5px; border-width:1px; border-color:#806c44; background-color:#17120de8; text-align:center; }
.store-open .normal-block { display:none; } .store-open .store-label { display:block; }
.store-tag, .store-name, .store-title { position:relative; display:block; height:16px; line-height:16px; white-space:nowrap; overflow:hidden; }
.store-name { font-weight:bold; } .highlighted .store-tag { color:#ffcf66; }
.chat-anchor { display:none; position:absolute; left:-121px; bottom:42px; width:242px; text-align:center; }
.has-guild .chat-anchor { bottom:58px; } .has-chat .chat-anchor { display:block; }
.chat-bubble { display:inline-block; max-width:220px; padding:7px 11px; position:relative; background-color:#101010e8; border-width:1px; border-color:#5c5540; color:#fff; line-height:14px; white-space:normal; }
.chat-text { position:relative; } .chat-tail { position:absolute; left:50%; margin-left:-5px; bottom:-10px; width:10px; height:10px; }
