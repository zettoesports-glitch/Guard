body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    pointer-events: none;
}

.command-window,
.command-window div,
.command-window span {
    position: absolute;
    box-sizing: border-box;
}

.command-window {
    display: none;
    width: 327px;
    height: 639px;
    pointer-events: auto;
}

.command-window-back {
    left: 0px;
    top: 0px;
    width: 327px;
    height: 639px;
    background-color: #10151ded;
    border-width: 1px;
    border-color: #695f48;
}

.command-window-title {
    left: 60px;
    top: 25px;
    width: 207px;
    height: 23px;
    color: #ffc000;
    font-size: 15px;
    line-height: 23px;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
}

.command-window-drag {
    left: 13px;
    top: 16px;
    width: 282px;
    height: 42px;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.command-window-close {
    right: 18px;
    top: 22px;
    width: 21px;
    height: 21px;
    color: #d7d7d7;
    background-color: #3a2727;
    border-width: 1px;
    border-color: #6e4a4a;
    line-height: 19px;
    text-align: center;
    pointer-events: auto;
}

.command-button {
    left: 101px;
    width: 128px;
    height: 35px;
    color: #c6c6c6;
    background-color: #252b33;
    border-width: 1px;
    border-color: #5d5748;
    overflow: hidden;
    pointer-events: auto;
}

.command-button span {
    left: 4px;
    top: 0px;
    width: 118px;
    height: 33px;
    line-height: 33px;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
}

.command-button:hover {
    color: #fff2c8;
    border-color: #887853;
}

.command-button.selected {
    color: #ffd36f;
    background-color: #494131;
    border-color: #9a814e;
}

.command-button.disabled {
    opacity: 0.4;
}
