body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    font-size: 14px;
    color: #c6c6c6;
    pointer-events: none;
}

#server-select {
    position: absolute;
    width: 500px;
    height: 460px;
    pointer-events: auto;
}

#title {
    position: absolute;
    left: 16px;
    top: 15px;
    width: 468px;
    height: 20px;
    line-height: 20px;
    text-align: center;
    color: #ffc000;
}

#title-divider { position: absolute; left: 106px; top: 47px; }

.server-list {
    position: absolute;
    top: 64px;
    height: 286px;
    padding: 4px;
    border-width: 1px;
    border-color: #473423;
    background-color: #050403d9;
    overflow-x: hidden;
    overflow-y: auto;
    pointer-events: auto;
}

#group-list { left: 20px; width: 132px; }
#server-list { left: 164px; width: 316px; }

.server-group,
.server-row {
    position: relative;
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 27px;
    margin-bottom: 2px;
    padding: 4px 7px;
    border-width: 1px;
    border-color: #3d2b1d;
    background-color: #100c09e6;
    color: #c6c6c6;
    font-size: 13px;
    pointer-events: auto;
}

.server-group:hover,
.server-row:hover {
    border-color: #8d5b25;
    background-color: #4a2912ed;
}

.server-group.selected {
    border-color: #c27c23;
    background-color: #5b3214ed;
    color: #f0b501;
}

.server-row.pvp { color: #b00000; }
.server-row.non-pvp { color: #00b000; }
.server-row.gold { color: #f0b501; }
.server-row.busy { color: #99958d; }
.server-row.offline {
    color: #6f6f6f;
    pointer-events: none;
}

.server-name {
    position: absolute;
    left: 7px;
    right: 7px;
    top: 3px;
    height: 16px;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
}

.server-load {
    position: absolute;
    left: 7px;
    right: 7px;
    top: 21px;
    height: 3px;
    background-color: #262626;
    pointer-events: none;
}

.server-load-fill {
    display: block;
    height: 3px;
    background-color: #b00000;
}
.server-row.non-pvp .server-load-fill { background-color: #00b000; }
.server-row.gold .server-load-fill { background-color: #f0b501; }
.server-row.busy .server-load-fill,
.server-row.offline .server-load-fill { background-color: #80807d; }

#bottom-divider { position: absolute; left: 103px; top: 360px; }

#description,
#advisory {
    position: absolute;
    left: 24px;
    width: 452px;
    text-align: center;
    white-space: pre-wrap;
    overflow: hidden;
}

#description {
    top: 374px;
    height: 34px;
    color: #c6c6c6;
}
#advisory {
    top: 408px;
    height: 42px;
    color: #f0b501;
    font-size: 12px;
}
