body { margin:0px; width:100%; height:100%; overflow:hidden; font-family:Arial; }
#login-bottom-root, #login-bottom-root div { position:absolute; box-sizing:border-box; }
#login-bottom-root { pointer-events:auto; }
.scene-button { top:0px; width:70px; height:30px; line-height:30px; text-align:center; pointer-events:auto; border-width:1px; border-color:#665b43; background-color:#282c34; color:#d8d8d8; }
.scene-button:hover { border-color:#9a8659; color:#fff0c0; }
