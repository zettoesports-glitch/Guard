body { margin:0px; width:100%; height:100%; overflow:hidden; font-family:Arial; }
#login-panel, #login-panel div, #login-panel span, #login-panel input { position:absolute; box-sizing:border-box; }
#login-panel { width:308px; height:190px; pointer-events:auto; }
#login-background { left:0px; top:0px; width:100%; height:100%; background-color:#151920f2; border-width:1px; border-color:#756847; pointer-events:none; }
#title { left:45px; top:20px; width:218px; height:25px; line-height:25px; text-align:center; color:#f0d488; font-size:18px; pointer-events:none; }
#server-name { left:45px; top:48px; width:218px; height:18px; line-height:18px; text-align:center; color:#c6c6c6; pointer-events:none; }
#account-label, #password-label { left:35px; width:75px; height:22px; line-height:22px; color:#bababa; pointer-events:none; }
#account-label { top:78px; } #password-label { top:108px; }
.mu-text-input { left:112px; width:158px; height:22px; line-height:20px; color:#f1f1f1; background-color:#0c0e12; border-width:1px; border-color:#5a513d; padding-left:5px; pointer-events:auto; }
#account-input { top:78px; } #password-input { top:108px; }
.mu-button { pointer-events:auto; border-width:1px; border-color:#665b43; background-color:#282c34; color:#dedede; text-align:center; }
.mu-button:hover { border-color:#9a8659; color:#fff0c0; }
.login-button { top:145px; width:90px; height:30px; line-height:30px; }
#ok-button { left:55px; } #cancel-button { left:163px; }
.login-button span { left:0px; top:0px; width:100%; height:100%; line-height:30px; pointer-events:none; }
