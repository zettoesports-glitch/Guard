body {
    margin: 0px;
    width: 100%;
    height: 100%;
    background-color: transparent;
    pointer-events: none;
}
#buff-list {
    position: absolute;
    width: 366px;
    min-height: 36px;
    transform-origin: 0 0;
}
#_BuffList,
#_DeBuffList {
    position: relative;
    display: block;
    width: 272px;
    min-height: 36px;
}
#_DeBuffList { margin-top: 3px; }

.BuffIcon,
.deBuffIcon {
    position: absolute;
    width: 26px;
    height: 36px;
    border-width: 1px;
    border-color: #625b4e;
    background-color: #20262ddd;
    pointer-events: auto;
    overflow: visible;
}
.deBuffIcon {
    border-color: #7f3939;
    background-color: #2d2020dd;
}
.buff-image {
    position: absolute;
    left: 2px;
    top: 2px;
    width: 20px;
    height: 28px;
    color: #dadada;
    font-size: 9px;
    line-height: 28px;
    text-align: center;
    background-color: #39434c;
    pointer-events: none;
}
.deBuffIcon .buff-image { background-color: #5a3030; }
.buff-count {
    position: absolute;
    right: -3px;
    top: -3px;
    min-width: 10px;
    height: 10px;
    color: #fff2a0;
    font-size: 8px;
    text-align: center;
    background-color: #000000bb;
    pointer-events: none;
}
.buff-time {
    position: absolute;
    left: -12px;
    top: 31px;
    width: 50px;
    height: 10px;
    color: #c6a8e8;
    font-size: 8px;
    text-align: center;
    white-space: nowrap;
    pointer-events: none;
}
