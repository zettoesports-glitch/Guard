<rml>
<head>
    <title>Reconstructed Map</title>
    <meta name="mu-design-Map-InitialScaleX" content="2.25"/>
    <meta name="mu-design-Map-InitialScaleY" content="1.5"/>
    <meta name="mu-design-Map-InitialAlpha" content="55.0"/>
    <meta name="mu-design-Map-CenterYOffset" content="30.0"/>
    <meta name="mu-design-Map-HelpDelayMs" content="6000.0"/>
    <meta name="mu-design-Map-HelpFadeSeconds" content="1.6"/>
    <meta name="mu-design-Map-SmallScale" content="0.83"/>
    <meta name="mu-design-Map-MaskSize" content="800.0 600.0"/>
    <meta name="mu-design-Map-RotationMatrix" content="0.7070770263671875 0.707061767578125 -0.707061767578125 0.7070770263671875"/>
    <meta name="mu-design-Map-FrameRate" content="24.0"/>
    <meta name="mu-design-Map-AlphaStep" content="25.0"/>
    <meta name="mu-design-Map-AlphaMin" content="25.0"/>
    <meta name="mu-design-Map-AlphaMax" content="85.0"/>
    <meta name="mu-design-Map-ScaleStep" content="25.0"/>
    <meta name="mu-design-Map-ScaleMin" content="125.0"/>
    <meta name="mu-design-Map-ScaleMax" content="350.0"/>
    <meta name="mu-design-Map-ImageAlphaFactor" content="0.7"/>
    <meta name="mu-design-Map-IconAlphaOffset" content="15.0"/>
    <meta name="mu-design-Map-SmallStageHeight" content="700.0"/>
    <meta name="mu-design-Map-NameScale" content="150.0"/>
    <meta name="mu-design-Map-IconRotation" content="-45.0 -45.0"/>
    <meta name="mu-design-Map-LabelExtra" content="5.0"/>
    <meta name="mu-design-Map-HelpFadeCurve" content="1.001 2.0 -10.0"/>
    <meta name="mu-design-Map-HeroFrames" content="30"/>
    <meta name="mu-design-Map-PortalGrid" content="28.25 81.25"/>
    <link type="text/rcss" href="../Common/common.rcss"/>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="minimap.rcss"/>
</head>
<body>
    <div id="map-root">
        <div id="map-host">
            <map-view id="map-view"/>
        </div>
        <div id="map-markers"/>
        <div id="map-hero"><div class="map-hero-arrow"/></div>
        <div id="map-help">
            <div id="txAlphaDownKey" class="map-key">[</div>
            <div id="txAlphaUpKey" class="map-key">]</div>
            <div id="txSizeDownKey" class="map-key">-</div>
            <div id="txSizeUpKey" class="map-key">+</div>
            <div id="txAlphaControl" class="map-help-text">Opacity</div>
            <div id="txSizeControl" class="map-help-text zoom">Zoom</div>
        </div>
    </div>
</body>
</rml>
