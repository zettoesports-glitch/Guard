<rml>
<head>
    <meta name="mu-design-Panel-Size" content="925.9 711.9"/>
    <meta name="mu-design-Skill-Columns" content="25"/>
    <meta name="mu-design-Legacy-ReferenceSize" content="640 480"/>
    <meta name="mu-design-Tooltip-BottomThreshold" content="300"/>
    <title>Reconstructed Master Skill Tree</title>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="master_tree.rcss"/>
</head>
<body class="mu-modern-document">
<div id="master-tree">
    <div id="master-background" class="master-background"/>
    <div id="btnExp" class="mu-button master-exp-button"/>
    <div id="btnClose" class="mu-button master-close-button">X</div>
    <div id="btnDrag" class="master-drag"/>
    <div id="tfExp" class="master-label exp"/>
    <div id="tfPoint" class="master-label point"/>
    <div id="tfLevel" class="master-label level"/>
    <div id="tfClass" class="master-label class-name"/>
    <div id="tfAttribute1" class="master-label category category-1"/>
    <div id="tfAttribute2" class="master-label category category-2"/>
    <div id="tfAttribute3" class="master-label category category-3"/>
    <div id="mcSkillSlots">
