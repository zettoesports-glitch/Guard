body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    pointer-events: none;
}

.top-menu,
.top-menu div {
    position: absolute;
    box-sizing: border-box;
}

.top-menu {
    display: none;
    width: 341px;
    height: 39px;
    transform-origin: 0 0;
    pointer-events: none;
}

.top-menu-wing {
    top: 0px;
    height: 29px;
    background-color: #171a20dd;
    border-color: #5d5545;
}

#top-menu-wing-back {
    left: 35px;
    width: 185px;
    border-bottom-width: 1px;
}

#top-menu-wing-controls {
    left: 156px;
    width: 185px;
    border-bottom-width: 1px;
}

#top-menu-map-frame {
    left: 0px;
    top: 0px;
    width: 186px;
    height: 36px;
    border-width: 1px;
    border-color: #665b45;
    background-color: #11151de6;
}

.top-menu-text {
    top: 6px;
    height: 16px;
    color: #ffffff;
    font-size: 12px;
    line-height: 14px;
    text-align: center;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
}

#top-menu-map-name {
    left: 21px;
    width: 76px;
}

#top-menu-position {
    left: 102px;
    width: 46px;
}

.top-menu-button {
    top: 10px;
    width: 29px;
    height: 29px;
    border-width: 1px;
    border-color: #514a3c;
    background-color: #262b34;
    color: #d0d0d0;
    font-size: 9px;
    line-height: 27px;
    text-align: center;
    pointer-events: auto;
}

.top-menu-button:hover {
    color: #fff2c8;
    border-color: #8d7b55;
}

.top-menu-button.disabled {
    opacity: 0.4;
}

#top-menu-option {
    left: 208px;
}

#top-menu-action {
    left: 238px;
}

#top-menu-action.start {
    background-color: #29472d;
}

#top-menu-action.stop {
    background-color: #5a2929;
}
