body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    font-size: 12px;
    color: #c8c5bc;
}

#mu-helper,
#mu-helper div,
#mu-helper input {
    position: absolute;
    box-sizing: border-box;
}

.mu-helper {
    width: 327px;
    height: 639px;
    pointer-events: auto;
}

.helper-background {
    left: 0px;
    top: 0px;
    width: 327px;
    height: 639px;
    background-color: #11151def;
    border-width: 1px;
    border-color: #675f45;
    pointer-events: none;
}

.helper-drag {
    left: 10px;
    top: 26px;
    width: 306px;
    height: 50px;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.helper-close {
    left: 272px;
    top: 43px;
    width: 19px;
    height: 19px;
    line-height: 19px;
    text-align: center;
    pointer-events: auto;
}

.helper-tab {
    top: 85px;
    width: 77px;
    height: 31px;
    line-height: 31px;
    text-align: center;
    background-color: #292923;
    border-width: 1px;
    border-color: #55503d;
    pointer-events: auto;
}

.helper-tab.selected {
    color: #ffd970;
    background-color: #4a4130;
}

.tab-hunt { left: 29px; }
.tab-item { left: 107px; }
.tab-other { left: 185px; }

.helper-page {
    left: 20px;
    top: 122px;
    width: 286px;
    height: 440px;
}

.section-title,
.assigned-title,
.manual-yield-label {
    color: #d5cdae;
    height: 20px;
    line-height: 20px;
}

.range-title {
    left: 10px;
    top: 5px;
    width: 120px;
}

.range-buttons {
    left: 10px;
    top: 28px;
    width: 260px;
    height: 25px;
}

.helper-range {
    top: 0px;
    width: 29px;
    height: 23px;
    line-height: 23px;
    text-align: center;
    background-color: #292923;
    border-width: 1px;
    border-color: #55503d;
    pointer-events: auto;
}

.helper-range.selected {
    color: #ffd970;
    border-color: #bd9b43;
}

.helper-range:nth-child(1) { left: 0px; }
.helper-range:nth-child(2) { left: 31px; }
.helper-range:nth-child(3) { left: 62px; }
.helper-range:nth-child(4) { left: 93px; }
.helper-range:nth-child(5) { left: 124px; }
.helper-range:nth-child(6) { left: 155px; }
.helper-range:nth-child(7) { left: 186px; }
.helper-range:nth-child(8) { left: 217px; }

.helper-toggle {
    left: 10px;
    width: 125px;
    height: 22px;
    line-height: 22px;
    padding-left: 22px;
    pointer-events: auto;
}

.helper-toggle:before {
    content: "";
    position: absolute;
    left: 2px;
    top: 4px;
    width: 12px;
    height: 12px;
    border-width: 1px;
    border-color: #71694e;
    background-color: #171717;
}

.helper-toggle.checked:before {
    background-color: #e0ae35;
}

#fallback-basic { top: 65px; }
#long-counter { top: 90px; }
#return-position { top: 115px; }
#use-potion { left: 145px; top: 65px; }
#support-party { left: 145px; top: 90px; }
#auto-heal { left: 145px; top: 115px; }
#drain-life { left: 145px; top: 140px; }
#buff-duration { left: 10px; top: 165px; }
#combo { left: 10px; top: 190px; }
#use-dark-raven { left: 145px; top: 190px; }

.helper-input,
.item-name,
.manual-yield {
    height: 20px;
    background-color: #111111;
    color: #e6dfc8;
    border-width: 1px;
    border-color: #5d5747;
}

#return-seconds {
    left: 105px;
    top: 116px;
    width: 35px;
}

.helper-gear {
    width: 24px;
    height: 22px;
    line-height: 22px;
    text-align: center;
    pointer-events: auto;
}

#potion-settings { left: 250px; top: 65px; }
#party-settings { left: 250px; top: 90px; }

.assigned-title {
    left: 10px;
    top: 225px;
    width: 130px;
}

.assigned-skills {
    left: 10px;
    top: 250px;
    width: 240px;
    height: 90px;
}

.helper-slot,
.available-slot {
    width: 32px;
    height: 40px;
    border-width: 1px;
    border-color: #4f4a3c;
    background-color: #16191dcc;
    pointer-events: auto;
}

.helper-slot.occupied,
.available-slot.occupied {
    background-color: #283441dd;
}

.helper-slot.selected {
    border-color: #e1bd54;
}

#assigned-skill-0 { left: 0px; top: 0px; }
#assigned-skill-1 { left: 38px; top: 0px; }
#assigned-skill-2 { left: 76px; top: 0px; }
#assigned-skill-3 { left: 114px; top: 0px; }
#assigned-skill-4 { left: 152px; top: 0px; }
#assigned-skill-5 { left: 190px; top: 0px; }

.skill-1-settings { left: 90px; top: 305px; }
.skill-2-settings { left: 125px; top: 305px; }

#page-item .helper-toggle {
    width: 130px;
}

#repair-item { top: 65px; }
#pick-all { top: 90px; }
#pick-selected { top: 115px; }
#pick-jewel { top: 140px; }
#pick-ancient { left: 145px; top: 140px; }
#pick-zen { top: 165px; }
#pick-excellent { left: 145px; top: 165px; }
#pick-extra { top: 190px; }

.item-name {
    left: 10px;
    top: 225px;
    width: 190px;
}

.item-action {
    width: 65px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    pointer-events: auto;
}

.item-action.add { left: 205px; top: 223px; }
.item-action.delete { left: 205px; top: 365px; }

.item-list {
    left: 10px;
    top: 260px;
    width: 230px;
    height: 90px;
    border-width: 1px;
    border-color: #4f493c;
    overflow: hidden;
}

.item-row {
    left: 0px;
    width: 228px;
    height: 18px;
    line-height: 18px;
    padding-left: 5px;
    pointer-events: auto;
}

.item-row.selected {
    color: #ffc000;
    background-color: #4c2c1260;
}

#item-row-0 { top: 0px; }
#item-row-1 { top: 18px; }
#item-row-2 { top: 36px; }
#item-row-3 { top: 54px; }
#item-row-4 { top: 72px; }

.helper-scroll {
    left: 245px;
    top: 260px;
    width: 20px;
    height: 90px;
    pointer-events: auto;
}

.mu-scrollbar-track {
    left: 5px;
    top: 16px;
    width: 10px;
    height: 58px;
}

.mu-scrollbar-button {
    left: 0px;
    width: 20px;
    height: 16px;
    line-height: 16px;
    text-align: center;
    pointer-events: auto;
}

.scroll-up { top: 0px; }
.scroll-down { bottom: 0px; }

.mu-scrollbar-thumb {
    left: 4px;
    top: 17px;
    width: 12px;
    height: 20px;
    background-color: #777;
    pointer-events: auto;
}

#page-other .helper-toggle {
    left: 20px;
    width: 230px;
}

#accept-friend { top: 25px; }
#accept-guild { top: 55px; }
#self-defense { top: 85px; }

.manual-yield-label {
    left: 20px;
    top: 130px;
    width: 155px;
}

.manual-yield {
    left: 180px;
    top: 130px;
    width: 45px;
}

.skill-picker {
    display: none;
    left: -76px;
    top: 337px;
    width: 72px;
    height: 225px;
}

.available-slot {
    width: 32px;
    height: 40px;
}

#available-skill-0 { left: 0px; top: 0px; }
#available-skill-1 { left: 36px; top: 0px; }
#available-skill-2 { left: 0px; top: 45px; }
#available-skill-3 { left: 36px; top: 45px; }
#available-skill-4 { left: 0px; top: 90px; }
#available-skill-5 { left: 36px; top: 90px; }
#available-skill-6 { left: 0px; top: 135px; }
#available-skill-7 { left: 36px; top: 135px; }
#available-skill-8 { left: 0px; top: 180px; }
#available-skill-9 { left: 36px; top: 180px; }

.helper-bottom {
    top: 578px;
    width: 95px;
    height: 35px;
    line-height: 35px;
    text-align: center;
    color: #ffc000;
    pointer-events: auto;
}

.helper-bottom.reset { left: 65px; }
.helper-bottom.save { left: 166px; }
