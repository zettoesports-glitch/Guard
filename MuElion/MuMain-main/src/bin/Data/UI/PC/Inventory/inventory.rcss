body { margin: 0px; width: 100%; height: 100%; overflow: hidden; font-family: Arial; }
#inventory, #inventory div { position: absolute; box-sizing: border-box; }
#inventory { left: 360px; top: 40px; width: 327px; height: 639px; pointer-events: auto; }
#inventory-background { left:0px; top:0px; width:327px; height:639px; background-color:#171a20f0; border-width:1px; border-color:#6b6048; pointer-events:none; }
.inventory-label { color:#ddd2af; font-size:12px; line-height:18px; white-space:nowrap; overflow:hidden; pointer-events:none; }
.title { left:60px; top:42px; width:190px; text-align:center; }
.zen { left:60px; top:338px; width:205px; text-align:right; color:#f4cc64; }
.inventory-drag { left:20px; top:25px; width:270px; height:50px; drag:drag; cursor:move; pointer-events:auto; }
.mu-button { pointer-events:auto; border-width:1px; border-color:#665b43; background-color:#282c34; color:#d8d8d8; text-align:center; }
.mu-button:hover { border-color:#9a8659; color:#fff0c0; }
.close-button { left:272px; top:42px; width:19px; height:19px; line-height:19px; }
.action-button { width:70px; height:30px; line-height:30px; font-size:10px; }
.action-button.socket { left:160px; top:323px; }
.action-button.set { left:160px; top:587px; }
.action-button.repair { left:228px; top:587px; }
.action-button.store { left:91px; top:323px; }
.action-button.extension { left:22px; top:323px; }
.mu-item-slot { pointer-events:auto; border-width:1px; border-color:#4e493e; background-color:#11151b; }
.mu-item-slot:hover { border-color:#b39a63; }
.mu-item-slot.disabled { opacity:.45; pointer-events:none; }
#inventory-grid { left:60px; top:370px; width:208px; height:208px; pointer-events:none; }
.inventory-grid-slot { width:26px; height:26px; }
