body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
}

#inventory,
#inventory div {
    position: absolute;
    box-sizing: border-box;
}

.inventory-panel {
    width: 327px;
    height: 639px;
    pointer-events: auto;
}

.inventory-background {
    left: 0px;
    top: 0px;
    width: 327px;
    height: 639px;
    background-color: #11151de8;
    border-width: 1px;
    border-color: #675f45;
    pointer-events: none;
}

.inventory-title {
    left: 48px;
    top: 38px;
    width: 220px;
    height: 24px;
    color: #f1d78d;
    text-align: center;
    line-height: 24px;
    pointer-events: none;
}

.inventory-zen {
    left: 60px;
    top: 334px;
    width: 208px;
    height: 24px;
    color: #e6c66c;
    text-align: right;
    line-height: 24px;
    pointer-events: none;
}

.inventory-drag {
    left: 28px;
    top: 22px;
    width: 244px;
    height: 44px;
    drag: drag;
    cursor: move;
    pointer-events: auto;
}

.inventory-close {
    left: 272px;
    top: 42px;
    width: 19px;
    height: 19px;
    line-height: 19px;
    text-align: center;
    pointer-events: auto;
}

.mu-item-slot {
    border-width: 1px;
    border-color: #4f4a3c;
    background-color: #16191dcc;
    pointer-events: auto;
}

.mu-item-slot.occupied {
    background-color: #283441dd;
}

.mu-item-slot.selected {
    border-color: #e1bd54;
}

.mu-item-slot.disabled {
    opacity: 0.45;
}

.inventory-grid {
    left: 60px;
    top: 370px;
    width: 208px;
    height: 208px;
    pointer-events: auto;
}

.inventory-action {
    height: 30px;
    line-height: 30px;
    text-align: center;
    color: #d7d3c5;
    background-color: #2c2b27;
    border-width: 1px;
    border-color: #615a47;
    pointer-events: auto;
}

.inventory-action.selected {
    color: #ffe59a;
    border-color: #c7a753;
}

.inventory-action.disabled {
    opacity: 0.45;
}

.option-left {
    left: 91px;
    top: 323px;
    width: 70px;
}

.option-right {
    left: 160px;
    top: 323px;
    width: 70px;
}

.bottom {
    top: 587px;
    width: 70px;
}

.extension {
    left: 22px;
}

.repair {
    left: 160px;
}

.store {
    left: 228px;
}
