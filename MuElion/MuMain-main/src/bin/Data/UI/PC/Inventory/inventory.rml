<rml>
<head>
    <meta name="mu-design-Inventory-Size" content="327 639"/>
    <meta name="mu-design-Inventory-Grid" content="60 370 26 26"/>
    <meta name="mu-design-Inventory-Equipment0" content="28 147 52 78"/>
    <meta name="mu-design-Inventory-Equipment1" content="247 147 52 78"/>
    <meta name="mu-design-Inventory-Equipment2" content="137 85 52 52"/>
    <meta name="mu-design-Inventory-Equipment3" content="138 147 52 78"/>
    <meta name="mu-design-Inventory-Equipment4" content="138 235 52 52"/>
    <meta name="mu-design-Inventory-Equipment5" content="28 235 52 52"/>
    <meta name="mu-design-Inventory-Equipment6" content="247 235 52 52"/>
    <meta name="mu-design-Inventory-Equipment7" content="210 85 89 52"/>
    <meta name="mu-design-Inventory-Equipment8" content="28 85 52 52"/>
    <meta name="mu-design-Inventory-Equipment9" content="92 104 33 33"/>
    <meta name="mu-design-Inventory-Equipment10" content="93 254 33 33"/>
    <meta name="mu-design-Inventory-Equipment11" content="202 254 33 33"/>
    <meta name="mu-design-Inventory-Reference" content="640 480"/>
    <meta name="mu-design-Inventory-InitialPosition" content="360 40"/>
    <meta name="mu-design-Inventory-Button0" content="272 42 19 19"/>
    <meta name="mu-design-Inventory-Button1" content="160 323 70 30"/>
    <meta name="mu-design-Inventory-Button2" content="160 587 70 30"/>
    <meta name="mu-design-Inventory-Button3" content="228 587 70 30"/>
    <meta name="mu-design-Inventory-Button4" content="91 323 70 30"/>
    <meta name="mu-design-Inventory-Button5" content="22 323 70 30"/>
    <title>Reconstructed Inventory</title>
    <link type="text/rcss" href="../Common/common.rcss"/>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="inventory.rcss"/>
</head>
<body class="mu-modern-document">
    <div id="inventory" class="inventory-panel">
        <div id="inventory-background" class="inventory-background"/>
        <div id="tfTitle" class="inventory-title">Inventory</div>
        <div id="tfZen" class="inventory-zen"/>
        <div id="btnDrag" class="inventory-drag"/>
        <div id="btnClose" class="mu-button inventory-close">X</div>

        <div id="slot_weapon_right" class="mu-item-slot equipment-slot"/>
        <div id="slot_weapon_left" class="mu-item-slot equipment-slot"/>
        <div id="slot_helm" class="mu-item-slot equipment-slot"/>
        <div id="slot_armor" class="mu-item-slot equipment-slot"/>
        <div id="slot_pants" class="mu-item-slot equipment-slot"/>
        <div id="slot_gloves" class="mu-item-slot equipment-slot"/>
        <div id="slot_boots" class="mu-item-slot equipment-slot"/>
        <div id="slot_wing" class="mu-item-slot equipment-slot"/>
        <div id="slot_helper" class="mu-item-slot equipment-slot"/>
        <div id="slot_amulet" class="mu-item-slot equipment-slot"/>
        <div id="slot_ring_left" class="mu-item-slot equipment-slot"/>
        <div id="slot_ring_right" class="mu-item-slot equipment-slot"/>

        <div id="btnSetOption" class="mu-button inventory-action option-left">Set</div>
        <div id="btnSocketOption" class="mu-button inventory-action option-right">Socket</div>

        <div id="inventory-grid" class="inventory-grid"/>

        <div id="btnExtensionBag" class="mu-button inventory-action bottom extension">Bag</div>
        <div id="btnRepair" class="mu-button inventory-action bottom repair">Repair</div>
        <div id="btnPrivateStore" class="mu-button inventory-action bottom store">Store</div>
    </div>
</body>
</rml>
