<rml>
<head>
    <meta name="mu-design-Extension-Width" content="327.5"/>
    <meta name="mu-design-Extension-Heights" content="223 361 499.05 636"/>
    <meta name="mu-design-Extension-GridX" content="60 60 60 60"/>
    <meta name="mu-design-Extension-GridY" content="90 230 366 504"/>
    <meta name="mu-design-Extension-PitchX" content="26"/>
    <meta name="mu-design-Extension-PitchY" content="26"/>
    <meta name="mu-design-Extension-Reference" content="640 480"/>
    <meta name="mu-design-Extension-InitialPosition" content="21 40"/>
    <title>Reconstructed Inventory Extension</title>
    <link type="text/rcss" href="../Common/common.rcss"/>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="inventory_extension.rcss"/>
</head>
<body class="mu-modern-document">
    <div id="extension" class="extension-panel">
        <div class="extension-background"/>
        <div id="tfTitle" class="extension-title">Expanded Inventory</div>
        <div id="btnDrag" class="extension-drag"/>
        <div id="btnClose" class="mu-button extension-close">X</div>

        <div id="extension-grid-0" class="extension-grid"/>
        <div id="extension-grid-1" class="extension-grid"/>
        <div id="extension-grid-2" class="extension-grid"/>
        <div id="extension-grid-3" class="extension-grid"/>

        <div id="extension-locked-0" class="extension-locked">Bag 1 locked</div>
        <div id="extension-locked-1" class="extension-locked">Bag 2 locked</div>
        <div id="extension-locked-2" class="extension-locked">Bag 3 locked</div>
        <div id="extension-locked-3" class="extension-locked">Bag 4 locked</div>
    </div>
</body>
</rml>
