body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
}

#panel,
#panel div,
#panel span {
    position: absolute;
    box-sizing: border-box;
}

.storage-panel {
    width: 327px;
    height: 639px;
    pointer-events: auto;
}

.storage-background {
    left: 0px;
    top: 0px;
    width: 327px;
    height: 639px;
    background-color: #11151def;
    border-width: 1px;
    border-color: #675f45;
    pointer-events: none;
}

.storage-title {
    left: 52px;
    top: 34px;
    width: 220px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    color: #f1d78d;
    pointer-events: none;
}

.storage-drag {
    left: 28px;
    top: 20px;
    width: 245px;
    height: 45px;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.storage-close {
    right: 34px;
    top: 34px;
    width: 19px;
    height: 19px;
    line-height: 19px;
    text-align: center;
    pointer-events: auto;
}

.storage-grid {
    left: 60px;
    top: 102px;
    width: 208px;
    height: 390px;
    pointer-events: auto;
}

.storage-slot {
    border-width: 1px;
    border-color: #4f4a3c;
    background-color: #16191dcc;
    pointer-events: auto;
}

.storage-slot.occupied {
    background-color: #283441dd;
}

.storage-slot.selected {
    border-color: #e1bd54;
}

.storage-charge {
    left: 42px;
    top: 500px;
    width: 244px;
    height: 95px;
}

.storage-label {
    color: #aaa58f;
    height: 18px;
    line-height: 18px;
    pointer-events: none;
}

.storage-value {
    color: #edca66;
    height: 18px;
    line-height: 18px;
    text-align: right;
    pointer-events: none;
}

.keep-label { left: 0px; top: 0px; width: 90px; }
.keep-value { left: 100px; top: 0px; width: 130px; }
.charge-label { left: 0px; top: 20px; width: 90px; }
.charge-value { left: 100px; top: 20px; width: 130px; }

.storage-action {
    top: 48px;
    width: 55px;
    height: 25px;
    line-height: 25px;
    text-align: center;
    color: #d8d2c0;
    background-color: #2c2b27;
    border-width: 1px;
    border-color: #615a47;
    pointer-events: auto;
}

.deposit { left: 0px; }
.withdraw { left: 59px; }
.lock { left: 118px; }
.extend { left: 177px; }

.lock.locked {
    border-color: #d18b57;
}

.storage-zen-info {
    right: -3px;
    top: 1px;
    width: 18px;
    height: 18px;
    line-height: 18px;
    text-align: center;
    pointer-events: auto;
}

.storage-period {
    left: 42px;
    top: 475px;
    width: 244px;
    height: 25px;
}

.period-label { left: 0px; top: 0px; width: 90px; }
.period-value { left: 100px; top: 0px; width: 130px; }

.storage-exit {
    left: 128px;
    top: 602px;
    width: 70px;
    height: 25px;
    line-height: 25px;
    text-align: center;
    pointer-events: auto;
}

.storage-action.disabled,
.storage-slot.disabled {
    opacity: 0.45;
}
