body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
}

.private-store,
.private-store div,
.private-store span,
.private-store input {
    position: absolute;
    box-sizing: border-box;
}

.private-store {
    width: 327px;
    height: 289px;
    pointer-events: auto;
}

.private-store-background {
    left: 0px;
    top: 0px;
    width: 327px;
    height: 289px;
    background-color: #11151def;
    border-width: 1px;
    border-color: #675f45;
    pointer-events: none;
}

.private-store-title {
    left: 50px;
    top: 34px;
    width: 225px;
    height: 24px;
    line-height: 24px;
    text-align: center;
    color: #f1d78d;
    pointer-events: none;
}

.private-store-name-label {
    left: 35px;
    top: 78px;
    width: 70px;
    height: 22px;
    line-height: 22px;
    color: #d4c9aa;
    pointer-events: none;
}

.private-store-name,
.private-store-buyer-name {
    left: 103px;
    top: 78px;
    width: 165px;
    height: 22px;
    line-height: 20px;
}

.private-store-buyer-name {
    color: #e8dfc7;
    overflow: hidden;
    white-space: nowrap;
    pointer-events: none;
}

.private-store.seller .private-store-buyer-name {
    display: none;
}

.private-store.buyer .private-store-name {
    display: none;
}

.private-store-drag {
    left: 28px;
    top: 20px;
    width: 245px;
    height: 45px;
    drag: drag;
    cursor: move;
    pointer-events: auto;
}

.private-store-close {
    right: 34px;
    top: 34px;
    width: 19px;
    height: 19px;
    line-height: 19px;
    text-align: center;
    pointer-events: auto;
}

.private-store-button {
    top: 244px;
    width: 90px;
    height: 28px;
    line-height: 28px;
    text-align: center;
    color: #d7d3c5;
    background-color: #2c2b27;
    border-width: 1px;
    border-color: #615a47;
    pointer-events: auto;
}

.private-store-button.open {
    left: 72px;
}

.private-store-button.close-shop {
    left: 166px;
}

.private-store-slot {
    border-width: 1px;
    border-color: #4f4a3c;
    background-color: #16191dcc;
    pointer-events: auto;
}

.private-store-slot.occupied {
    background-color: #283441dd;
}

.private-store-slot.selected {
    border-color: #e1bd54;
}

.private-store-slot.drop-allowed,
.private-store-slot.drop-banned {
    border-width: 2px;
}

.private-store-button.disabled,
.private-store-slot.disabled {
    opacity: 0.45;
}
