body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
}

#extension,
#extension div {
    position: absolute;
    box-sizing: border-box;
}

.extension-panel {
    width: 327.5px;
    min-height: 223px;
    pointer-events: auto;
    overflow: hidden;
}

.extension-background {
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: #11151de8;
    border-width: 1px;
    border-color: #675f45;
    pointer-events: none;
}

.extension-title {
    left: 45px;
    top: 30px;
    width: 235px;
    height: 25px;
    line-height: 25px;
    text-align: center;
    color: #f1d78d;
    pointer-events: none;
}

.extension-drag {
    left: 28px;
    top: 18px;
    width: 245px;
    height: 45px;
    drag: drag;
    cursor: move;
    pointer-events: auto;
}

.extension-close {
    right: 34px;
    top: 34px;
    width: 19px;
    height: 19px;
    line-height: 19px;
    text-align: center;
    pointer-events: auto;
}

.extension-grid {
    width: 208px;
    height: 104px;
    pointer-events: auto;
}

.extension-slot {
    border-width: 1px;
    border-color: #4f4a3c;
    background-color: #16191dcc;
    pointer-events: auto;
}

.extension-slot.occupied {
    background-color: #283441dd;
}

.extension-slot.selected {
    border-color: #e1bd54;
}

.extension-locked {
    width: 208px;
    height: 104px;
    line-height: 104px;
    text-align: center;
    color: #80786c;
    background-color: #151515dd;
    border-width: 1px;
    border-color: #383838;
    pointer-events: none;
}
