body { margin:0px; width:100%; height:100%; overflow:hidden; font-family:Arial; }
#extension, #extension div { position:absolute; box-sizing:border-box; }
#extension { left:21px; top:40px; width:327.5px; height:223px; pointer-events:auto; overflow:hidden; }
.extension-background { left:0px; top:0px; width:100%; height:100%; background-color:#171a20f0; border-width:1px; border-color:#6b6048; pointer-events:none; }
.extension-title { left:60px; top:42px; width:200px; height:18px; color:#ddd2af; font-size:12px; text-align:center; pointer-events:none; }
.extension-drag { left:20px; top:25px; width:270px; height:50px; drag:drag; cursor:move; pointer-events:auto; }
.extension-close { left:272px; top:42px; width:19px; height:19px; line-height:19px; pointer-events:auto; border-width:1px; border-color:#665b43; background-color:#282c34; color:#d8d8d8; text-align:center; }
.extension-slot { width:26px; height:26px; pointer-events:auto; border-width:1px; border-color:#4e493e; background-color:#11151b; }
.extension-slot:hover { border-color:#b39a63; }
.extension-slot.mu-hidden { display:none; }
