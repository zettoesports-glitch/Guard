<rml>
<head>
    <title>Reconstructed Storage Password</title>
    <meta name="mu-design-Menu-Size" content="306 189"/>
    <meta name="mu-design-Menu-Reference" content="640 480"/>
    <link type="text/rcss" href="../Common/common.rcss"/>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="storage_security.rcss"/>
</head>
<body class="storage-password">
    <div id="menu" class="security-menu password-menu">
        <div class="security-title">Storage Password</div>
        <div id="taInputMent" class="security-prompt"/>
        <input id="tiInput" class="mu-text-input password-input" type="password"/>
        <div id="btnInputOk" class="mu-button security-action ok">OK</div>
        <div id="btnInputCancel" class="mu-button security-action cancel">Cancel</div>
    </div>
</body>
</rml>
