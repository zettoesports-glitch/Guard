<rml>
<head>
    <title>Gens Ranking</title>
    <meta name="mu-design-Panel-Size" content="327 639"/>
    <meta name="mu-design-Panel-Reference" content="640 480"/>
    <meta name="mu-design-Panel-Initial" content="20 20"/>
    <link type="text/rcss" href="../Common/common.rcss"/>
    <link type="text/rcss" href="../ui_assets.rcss"/>
    <link type="text/rcss" href="gens_ranking.rcss"/>
</head>
<body>
    <div id="panel" class="gens-panel">
        <div id="btnDrag" class="gens-drag"/>
        <div id="tfTitle" class="gens-title"/>
        <div id="btnClose" class="mu-button gens-close">X</div>

        <div class="gens-mark-box">
            <div id="mcMark_D" class="gens-mark duprian">D</div>
            <div id="mcMark_V" class="gens-mark vanert">V</div>
        </div>

        <div id="tfGensTeam" class="gens-label gens-team-label"/>
        <div id="tfGensTeamValue" class="gens-value gens-team-value"/>
        <div id="tfGensRanking" class="gens-label gens-grade-label"/>
        <div id="tfGensRankingValue" class="gens-value gens-grade-value"/>
        <div id="tfGrade" class="gens-grade-text"/>

        <div id="tfRanking" class="gens-label gens-ranking-label"/>
        <div id="tfRankingValue" class="gens-value gens-ranking-value"/>
        <div id="tfContribution" class="gens-label gens-contribution-label"/>
        <div id="tfContributionValue" class="gens-value gens-contribution-value"/>

        <div id="taGensState" class="gens-state"/>
        <div id="tfGensInfo" class="gens-info-title"/>
        <div id="taGensInfoMent" class="gens-info-text"/>
    </div>
</body>
</rml>
