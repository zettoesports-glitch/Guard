        <div id="party-member-3" class="party-member"><div id="party-background-3" class="party-background"/><div id="party-channel-3" class="party-channel"/><div id="party-name-3" class="party-name"/><div class="party-gauge-clip"><div id="party-hp-3" class="party-hp"/></div><div class="party-gauge-clip"><div id="party-mp-3" class="party-mp"/></div><div id="party-crown-3" class="party-crown">L</div><div id="party-leave-3" class="mu-button party-leave">X</div><div id="party-overlay-3" class="party-overlay"/></div>
        <div id="party-member-4" class="party-member"><div id="party-background-4" class="party-background"/><div id="party-channel-4" class="party-channel"/><div id="party-name-4" class="party-name"/><div class="party-gauge-clip"><div id="party-hp-4" class="party-hp"/></div><div class="party-gauge-clip"><div id="party-mp-4" class="party-mp"/></div><div id="party-crown-4" class="party-crown">L</div><div id="party-leave-4" class="mu-button party-leave">X</div><div id="party-overlay-4" class="party-overlay"/></div>
