body { margin:0; width:100%; height:100%; overflow:hidden; font-family:Arial; }
.party-frame, .party-frame div { position:absolute; box-sizing:border-box; }
.party-frame { display:none; width:150px; pointer-events:none; }
.party-dragbar { left:0; top:0; width:147px; height:19px; border-width:1px; border-color:#665b3e; background-color:#191d24e8; drag:drag; cursor:move; pointer-events:auto; }
.party-minimize { left:132px; top:3px; width:13px; height:13px; line-height:13px; text-align:center; font-size:10px; pointer-events:auto; }
.party-member { left:-1px; width:150px; height:45px; pointer-events:none; }
.party-background { left:0; top:0; width:150px; height:42px; border-width:1px; border-color:#504838; background-color:#151920e8; }
.party-member.out-of-sight .party-background { background-color:#3a1717e8; }
.party-member.selected .party-background { border-color:#d6bd72; }
.party-channel { left:4px; top:3px; width:20px; height:16px; line-height:16px; color:#d7b46b; overflow:hidden; white-space:nowrap; }
.party-name { left:25px; top:3px; width:98px; height:16px; line-height:16px; color:#eeeeee; overflow:hidden; white-space:nowrap; }
.party-gauge-clip { left:25px; width:120px; height:6px; overflow:hidden; clip:always; background-color:#090909; }
.party-gauge-clip:nth-of-type(4) { top:23px; }
.party-gauge-clip:nth-of-type(5) { top:32px; }
.party-hp, .party-mp { left:0; top:0; height:6px; width:0%; }
.party-hp { background-color:#b33a32; }
.party-mp { background-color:#315ea5; }
.party-crown { left:1px; top:21px; width:24px; height:19px; line-height:19px; text-align:center; color:#ffd45e; pointer-events:none; }
.party-leave { left:128px; top:3px; width:18px; height:18px; line-height:18px; text-align:center; color:#d8d8d8; pointer-events:auto; z-index:3; }
.party-overlay { left:1px; top:1px; width:147px; height:40px; pointer-events:auto; z-index:2; }
.party-overlay:hover { background-color:#ffffff10; }
.party-frame.minimized .party-member { display:none; }
.mu-hidden { display:none; }
