body{width:100%;height:100%;margin:0px;background-color:transparent;font-family:Arial}#panel,#panel div,#panel span{position:absolute;box-sizing:border-box}#panel{display:none;width:327px;height:639px;background-color:#151515ee;border-width:1px;border-color:#665b3e}#tfTitle{left:30px;top:16px;width:267px;height:24px;line-height:24px;text-align:center;color:#e7d59d;font-size:17px}#tfExplain{left:25px;top:55px;width:277px;height:20px;line-height:20px;text-align:center;color:#ddd}#btnDrag{left:10px;top:8px;width:280px;height:46px;drag:drag;cursor:move;pointer-events:auto}#btnClose{right:8px;top:8px;width:22px;height:22px;line-height:22px;text-align:center;pointer-events:auto}.mu-button{pointer-events:auto}.mu-button.disabled{opacity:.45}#tfDuelTitle0,#tfDuelTitle1,#tfDuelTitle2,#tfDuelTitle3{left:30px;width:267px;height:20px;line-height:20px;text-align:center;color:#ffeb83}#tfProgressDuel0,#tfProgressDuel1,#tfProgressDuel2,#tfProgressDuel3{left:25px;width:277px;height:24px;line-height:24px;text-align:center;color:#eee}.mu-button[id^="btnDuelWatch"]{left:122px;width:83px;height:26px;line-height:26px;text-align:center;background-color:#302c22;border-width:1px;border-color:#75694c}#tfDuelTitle0{top:100px}#tfProgressDuel0{top:126px}#btnDuelWatch0{top:158px}#tfDuelTitle1{top:220px}#tfProgressDuel1{top:246px}#btnDuelWatch1{top:278px}#tfDuelTitle2{top:340px}#tfProgressDuel2{top:366px}#btnDuelWatch2{top:398px}#tfDuelTitle3{top:460px}#tfProgressDuel3{top:486px}#btnDuelWatch3{top:518px}