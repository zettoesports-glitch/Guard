body {
    width: 100%;
    height: 100%;
    margin: 0px;
    overflow: hidden;
    font-family: Arial;
    pointer-events: none;
}

#panel, #panel div, #panel span {
    position: absolute;
    box-sizing: border-box;
}

.help-panel {
    width: 327px;
    height: 439px;
    background-color: #111722ee;
    border-width: 1px;
    border-color: #665a3d;
    pointer-events: auto;
}

.help-drag {
    left: 8px;
    top: 7px;
    width: 275px;
    height: 32px;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.help-title {
    left: 42px;
    top: 14px;
    width: 235px;
    height: 20px;
    color: #f1d786;
    text-align: center;
    line-height: 20px;
    pointer-events: none;
}

.help-close {
    right: 10px;
    top: 10px;
    width: 23px;
    height: 23px;
    text-align: center;
    line-height: 23px;
    color: #d9d9d9;
    pointer-events: auto;
}

.help-tab {
    top: 50px;
    width: 145px;
    height: 30px;
    line-height: 30px;
    text-align: center;
    color: #c6c6c6;
    pointer-events: auto;
}
.help-tab-left { left: 17px; }
.help-tab-right { left: 164px; }
.help-tab.selected {
    color: #fff0ba;
    background-color: #51462f;
}

.help-page {
    left: 17px;
    top: 88px;
    width: 294px;
    height: 334px;
}

.help-heading {
    left: 8px;
    top: 0px;
    width: 250px;
    height: 22px;
    color: #7fa8ff;
    font-size: 13px;
    line-height: 22px;
}

.help-description {
    left: 8px;
    top: 23px;
    width: 250px;
    height: 18px;
    color: #a8a8a8;
    font-size: 11px;
}

.help-list {
    left: 8px;
    top: 42px;
    width: 255px;
    height: 280px;
    overflow: hidden;
    clip: always;
    pointer-events: auto;
}

.help-row {
    position: relative;
    display: block;
    width: 100%;
    min-height: 19px;
    line-height: 19px;
    color: #e7e7e7;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
}

.help-scroll {
    right: 4px;
    top: 42px;
    width: 22px;
    height: 280px;
    pointer-events: auto;
}
.help-scroll > div {
    position: absolute;
    pointer-events: auto;
}
.mu-scrollbar-track {
    left: 4px;
    top: 15px;
    width: 14px;
    bottom: 15px;
}
.mu-scrollbar-up,
.mu-scrollbar-down {
    left: 0px;
    width: 22px;
    height: 15px;
    line-height: 15px;
    text-align: center;
    color: #c8c8c8;
}
.mu-scrollbar-up { top: 0px; }
.mu-scrollbar-down { bottom: 0px; }
.mu-scrollbar-thumb {
    left: 4px;
    top: 16px;
    width: 14px;
    height: 32px;
    min-height: 8px;
    background-color: #777777;
}
