body {
    width: 100%;
    height: 100%;
    margin: 0px;
    overflow: hidden;
    background-color: transparent;
    pointer-events: none;
    font-family: Arial;
}

#menu {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 37px;
    overflow: hidden;
    clip: always;
    pointer-events: none;
}

#notice-background {
    position: absolute;
    left: 0px;
    top: 0px;
    width: 100%;
    height: 100%;
    background-color: #000000b0;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: #000000;
    pointer-events: none;
}

#notice-text {
    position: absolute;
    top: 7px;
    height: 23px;
    line-height: 23px;
    white-space: nowrap;
    color: #c8dce6;
    font-size: 14px;
    pointer-events: none;
}

#menu.notice-priority #notice-text {
    font-weight: bold;
}
