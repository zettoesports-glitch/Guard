body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    font-size: 14px;
    line-height: 17px;
    color: #ffffff;
    pointer-events: none;
}

.mu-tooltip {
    display: none;
    position: absolute;
    box-sizing: border-box;
    padding: 5px 17px;
    min-width: 1px;
    color: #ffffff;
    background-color: #080a0dcc;
    border-width: 0px;
    text-align: center;
    line-height: 17px;
    white-space: nowrap;
    pointer-events: none;
}

.mu-tooltip.framed {
    border-width: 1px;
    border-color: #74684e;
    background-color: #080a0df0;
}

.tooltip-line {
    display: block;
    min-height: 17px;
}

.tooltip-line.blank {
    min-height: 8px;
}

.tooltip-line.bold {
    font-weight: bold;
}

.tooltip-line.blue { color: #80b3ff; }
.tooltip-line.gray { color: #ababab; }
.tooltip-line.red { color: #ff331a; }
.tooltip-line.yellow { color: #ffcc1a; }
.tooltip-line.green { color: #1aff80; }
.tooltip-line.purple { color: #ff1aff; }
.tooltip-line.red-purple { color: #cc80cc; }
.tooltip-line.violet { color: #b366ff; }
.tooltip-line.orange { color: #e66b0a; }

.tooltip-line.dark-red {
    color: #ffffff;
    background-color: #a00000;
}
.tooltip-line.dark-blue {
    color: #ffffff;
    background-color: #0000a0;
}
.tooltip-line.dark-yellow {
    color: #ffffff;
    background-color: #a06600;
}
.tooltip-line.green-blue {
    color: #00ff00;
    background-color: #3c3cc8;
}
