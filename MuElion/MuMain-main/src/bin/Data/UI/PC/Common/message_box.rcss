body { margin:0; width:100%; height:100%; overflow:hidden; font-family:Arial; color:#ddddda; }
#message-box, #message-box div, #message-box span, #message-box input { position:absolute; box-sizing:border-box; }
#message-box { display:none; width:352px; height:210px; border-width:1px; border-color:#665b3e; background-color:#11151df2; pointer-events:auto; }
.message-title { display:none; left:40px; top:16px; right:40px; height:20px; line-height:20px; text-align:center; color:#ffc000; }
.message-divider { left:13px; top:47px; width:326px; height:1px; background-color:#665b3e; }
.message { left:24px; top:72px; width:304px; line-height:20px; text-align:center; white-space:normal; }
#message-content { position:relative; left:0; top:0; width:100%; }
.message-line { position:relative !important; display:block; min-height:20px; }
.message-input { left:66px; top:119px; width:220px; height:23px; line-height:18px; border-width:1px; border-color:#5c5540; background-color:#0d0d0de8; color:#eee; }
.message-bottom { left:0; top:0; width:100%; height:100%; pointer-events:none; }
.message-bottom-divider { display:none; left:7px; top:0; width:293px; height:1px; background-color:#665b3e; }
.message-button { width:70px; height:30px; line-height:30px; text-align:center; border-width:1px; border-color:#71674f; background-color:#242830; pointer-events:auto; }
.message-button:hover { color:#fff2c8; border-color:#a58c58; }
#cancel-button { display:none; }
#message-box.two-buttons #cancel-button { display:block; }
#message-box.message-only #message { top:92px; }
#message-box.message-only #message-input { display:none; }
#message-box.s16-caution { width:308px; height:190px; }
#message-box.s16-caution .message-title { display:block; left:73px; top:17px; width:163px; font-size:12px; line-height:14px; }
#message-box.s16-caution .message-divider { left:7px; top:34px; width:293px; }
#message-box.s16-caution .message { left:26px; top:45px; width:251px; height:84px; line-height:14px; font-size:12px; color:#ababab; overflow:hidden; }
#message-box.s16-caution .message-line { min-height:14px; }
#message-box.s16-caution .message-input { left:60px; top:80px; width:188px; height:17px; line-height:14px; font-size:12px; }
#message-box.s16-caution .message-bottom-divider { display:block; }
#message-box.s16-caution.message-only .message { top:45px; }
.mu-hidden { display:none; }
