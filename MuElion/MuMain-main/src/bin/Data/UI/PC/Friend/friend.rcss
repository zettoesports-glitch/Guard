body { margin:0; width:100%; height:100%; overflow:hidden; font-family:Arial; color:#c8c8c8; }
.friend-panel, .friend-panel div, .friend-panel span, .friend-panel input, .friend-panel textarea, .friend-panel i { position:absolute; box-sizing:border-box; }
.friend-panel { display:none; border-width:1px; border-color:#665b3e; background-color:#11151def; pointer-events:auto; }
.friend-main { width:540px; height:381px; }
.friend-chat { width:425px; height:282px; }
.friend-chat.invite-open { width:553px; }
.friend-write { width:429px; height:282px; }
.friend-read { width:425px; height:278px; }
.friend-drag, .friend-popup-drag { left:12px; top:10px; right:40px; height:28px; drag:drag; cursor:move; }
.friend-title, .friend-popup-title { left:55px; top:14px; right:55px; height:20px; text-align:center; color:#ffc000; line-height:20px; }
.friend-close, .friend-popup-close { right:12px; top:12px; width:22px; height:22px; line-height:22px; text-align:center; pointer-events:auto; }
.friend-minimize { right:36px; top:12px; width:22px; height:22px; line-height:22px; text-align:center; pointer-events:auto; }
.friend-tab { top:62px; width:108px; height:31px; line-height:31px; text-align:center; pointer-events:auto; }
#friend-tab-0 { left:28px; } #friend-tab-1 { left:136px; } #friend-tab-2 { left:244px; }
.friend-tab.selected { color:#fff2c8; background-color:#55472f; }
.friend-refuse { left:410px; top:67px; width:112px; height:22px; line-height:22px; pointer-events:auto; }
.friend-refuse input { left:0; top:4px; width:14px; height:14px; } .friend-refuse span { left:20px; top:0; }
.friend-grid-title { left:28px; top:105px; width:456px; height:26px; }
.friend-header-check { left:0; top:3px; width:35px; height:20px; pointer-events:auto; }
.friend-header { top:3px; height:20px; line-height:20px; overflow:hidden; white-space:nowrap; }
#friend-header-0 { left:35px; width:190px; } #friend-header-1 { left:230px; width:220px; }
#friend-header-2, #friend-header-3 { display:none; }
.friend-main.mail #friend-header-0 { display:none; }
.friend-main.mail #friend-header-1 { left:55px; width:100px; }
.friend-main.mail #friend-header-2 { display:block; left:160px; width:90px; }
.friend-main.mail #friend-header-3 { display:block; left:255px; width:195px; }
.friend-main.window-list #friend-header-0 { left:8px; width:440px; }
.friend-main.window-list #friend-header-1 { display:none; }
.friend-rows { left:28px; top:132px; width:456px; height:160px; overflow:hidden; }
.friend-row { position:relative; display:block; left:0; top:auto; width:456px; height:28px; line-height:28px; pointer-events:auto; }
.friend-row.selected { background-color:#143b49; }
.friend-row span { top:0; height:28px; overflow:hidden; white-space:nowrap; }
.friend-row .data-grid-field-0 { left:35px; width:190px; }
.friend-row .data-grid-field-1 { left:230px; width:220px; }
.friend-row .data-grid-field-2, .friend-row .data-grid-field-3, .friend-row input, .friend-mail-icon { display:none; }
.friend-row.mail input { display:block; left:2px; top:7px; width:14px; height:14px; }
.friend-row.mail .friend-mail-icon { display:block; left:20px; top:8px; width:12px; height:12px; background-color:#d7b46b; }
.friend-row.mail .data-grid-field-0 { display:none; }
.friend-row.mail .data-grid-field-1 { left:55px; width:100px; }
.friend-row.mail .data-grid-field-2 { display:block; left:160px; width:90px; }
.friend-row.mail .data-grid-field-3 { display:block; left:255px; width:195px; }
.friend-main.window-list .friend-row .data-grid-field-0 { left:8px; width:440px; }
.friend-main.window-list .friend-row .data-grid-field-1 { display:none; }
.friend-scroll { left:488px; top:132px; width:22px; height:160px; }
.friend-scroll > .mu-scrollbar-track { left:3px; top:14px; width:16px; height:132px; }
.friend-scroll > .mu-scrollbar-button { left:0; width:22px; height:14px; text-align:center; }
.friend-scroll > .mu-scrollbar-button:nth-child(2) { bottom:0; }
.friend-scroll > .mu-scrollbar-button:nth-child(3) { top:0; }
.friend-scroll > .mu-scrollbar-thumb { left:3px; top:15px; width:16px; height:30px; background-color:#777; }
.friend-main-action { top:315px; width:95px; height:34px; line-height:34px; text-align:center; pointer-events:auto; }
#friend-action-0 { left:24px; } #friend-action-1 { left:121px; } #friend-action-2 { left:218px; } #friend-action-3 { left:315px; }
.friend-chat-messages { left:18px; top:45px; width:260px; height:175px; overflow:hidden; line-height:16px; }
.friend-chat-members { left:300px; top:45px; width:105px; height:175px; overflow:hidden; line-height:18px; color:#62c9ff; }
.friend-chat-input { left:18px; top:230px; width:260px; height:22px; }
.friend-popup-action { width:82px; height:32px; line-height:32px; text-align:center; pointer-events:auto; }
#friend-chat-toggle { left:300px; top:228px; }
.friend-chat-invite-rows { display:none; left:430px; top:45px; width:110px; height:176px; overflow:hidden; }
.friend-chat.invite-open .friend-chat-invite-rows { display:block; }
.friend-chat-invite-row { position:relative; display:block; left:0; top:auto; width:110px; height:21px; line-height:21px; overflow:hidden; pointer-events:auto; }
.friend-chat-invite-row.selected { background-color:#145268; }
#friend-chat-invite { display:none; left:438px; top:228px; }
.friend-chat.invite-open #friend-chat-invite { display:block; }
.friend-text-line { position:relative; display:block; left:0; top:auto; height:16px; line-height:16px; white-space:nowrap; overflow:hidden; }
.friend-form-label { left:24px; width:75px; height:20px; line-height:20px; }
#friend-write-receiver-label { top:49px; } #friend-write-subject-label { top:77px; }
.friend-write-receiver { left:100px; top:48px; width:290px; height:22px; }
.friend-write-subject { left:100px; top:76px; width:290px; height:22px; }
.friend-write-body { left:24px; top:105px; width:365px; height:105px; }
#friend-write-send { left:115px; top:225px; } #friend-write-close { left:210px; top:225px; }
#friend-read-sender-label { top:48px; } .friend-read-sender { left:100px; top:48px; width:280px; height:20px; overflow:hidden; }
.friend-read-body { left:24px; top:78px; width:365px; height:115px; overflow:hidden; white-space:pre-wrap; }
#friend-read-action-0 { left:15px; top:225px; } #friend-read-action-1 { left:95px; top:225px; }
#friend-read-action-2 { left:175px; top:225px; } #friend-read-action-3 { left:255px; top:225px; }
#friend-read-action-4 { left:335px; top:225px; }
.friend-read .friend-popup-action { width:74px; }
.minimized > *:not(.friend-popup-drag):not(.friend-popup-title):not(.friend-minimize):not(.friend-popup-close) { display:none; }
.mu-button:hover { color:#fff2c8; }
.mu-hidden { display:none; }
