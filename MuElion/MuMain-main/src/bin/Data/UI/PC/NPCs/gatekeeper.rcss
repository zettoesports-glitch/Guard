body{margin:0px;width:100%;height:100%;overflow:hidden;font-family:Arial}.gate-panel{position:absolute;left:20px;top:20px;width:327px;height:639px;background-color:#11161ff0;border-width:1px;border-color:#665b3e;color:#ddd;pointer-events:auto}.gate-drag{position:absolute;left:8px;top:6px;right:40px;height:34px;drag:drag;cursor:move}.gate-title{position:absolute;left:45px;top:12px;right:45px;height:25px;text-align:center;line-height:25px;color:#efc76e;font-size:15px}.gate-close{position:absolute;right:10px;top:10px;width:24px;height:24px;line-height:24px;text-align:center}.gate-heading{position:absolute;left:25px;top:78px;width:277px;text-align:center;color:#efd17d;font-size:14px}.gate-message{position:absolute;left:32px;top:112px;width:263px;height:70px;text-align:center;white-space:normal;color:#ddd}.gate-fee{position:absolute;left:35px;top:186px;width:257px;text-align:center;color:#ffe36d}.gate-check{position:absolute;left:48px;top:224px;width:230px;height:28px;line-height:28px}.gate-check-box{display:inline-block;width:18px;height:18px;margin-right:8px;border-width:1px;border-color:#7d7150}.gate-check.checked .gate-check-box{background-color:#c9a84d}.gate-setting{top:278px}.gate-stepper{position:absolute;left:69px;top:315px;width:190px;height:36px}.gate-stepper-bg{position:absolute;left:32px;top:0px;width:126px;height:36px;background-color:#080a0dcc;border-width:1px;border-color:#5d543d}.gate-stepper-btn{position:absolute;left:0px;top:0px;width:32px;height:36px;line-height:36px;text-align:center}.gate-next{left:158px}.gate-stepper-label{position:absolute;left:36px;top:0px;width:118px;height:36px;line-height:36px;text-align:center;color:#fff0b0}.gate-action{position:absolute;width:92px;height:32px;line-height:32px;text-align:center}.gate-set{left:118px;top:372px}.gate-help{position:absolute;left:35px;top:420px;width:257px;height:60px;white-space:normal;text-align:center;color:#aaa}.gate-enter{left:118px;bottom:62px}.disabled{opacity:0.45}