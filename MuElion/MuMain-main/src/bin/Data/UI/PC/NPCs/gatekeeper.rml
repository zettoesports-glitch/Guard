<rml>
<head>
<meta name="mu-design-Panel-Size" content="327 639"/>
<meta name="mu-design-Panel-Reference" content="640 480"/>
<meta name="mu-design-Panel-Initial" content="20 20"/>
<title>Reconstructed Gatekeeper</title>
<link type="text/rcss" href="../Common/common.rcss"/>
<link type="text/rcss" href="../ui_assets.rcss"/>
<link type="text/rcss" href="gatekeeper.rcss"/>
</head>
<body class="mu-modern-document">
<div id="panel" class="gate-panel">
 <div id="btnDrag" class="gate-drag"/>
 <div id="tfTitle" class="gate-title">Gatekeeper</div>
 <div id="btnClose" class="mu-button gate-close">X</div>
 <div id="tfEnterLimit" class="gate-heading"/>
 <div id="taEnterMent" class="gate-message"/>
 <div id="tfEnterFee" class="gate-fee"/>
 <div id="cbEnterCheck" class="mu-button gate-check"><span id="cbEnterCheck-input" class="gate-check-box"/><span id="cbEnterCheck-label"/></div>
 <div id="tfFeeSetting" class="gate-heading gate-setting"/>
 <div id="opZen" class="gate-stepper"><div id="opZen-background" class="gate-stepper-bg"/><div id="prevBtn" class="mu-button gate-stepper-btn">-</div><div id="nextBtn" class="mu-button gate-stepper-btn gate-next">+</div><span id="opZen-label" class="gate-stepper-label"/></div>
 <div id="btnSetConfirm" class="mu-button gate-action gate-set"><span id="btnSetConfirm-label">Confirm</span></div>
 <div id="taEnterFeeMent" class="gate-help"/>
 <div id="btnEnter" class="mu-button gate-action gate-enter"><span id="btnEnter-label">Enter</span></div>
</div>
</body>
</rml>