body {
    margin: 0px;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: Arial;
    pointer-events: none;
}

.pet-frame,
.pet-frame div {
    position: absolute;
    box-sizing: border-box;
}

.pet-frame {
    display: none;
    width: 100px;
    height: 184px;
    pointer-events: none;
}

.pet-dragbar {
    left: 0px;
    top: 0px;
    width: 100px;
    height: 19px;
    color: #d8d1bd;
    background-color: #171b22df;
    border-width: 1px;
    border-color: #665b45;
    font-size: 10px;
    line-height: 17px;
    padding-left: 6px;
    cursor: move;
    drag: drag;
    pointer-events: auto;
}

.pet-minimize {
    left: 82px;
    top: 3px;
    width: 13px;
    height: 13px;
    color: #d6d6d6;
    background-color: #30343a;
    border-width: 1px;
    border-color: #6e644f;
    font-size: 10px;
    line-height: 11px;
    text-align: center;
    pointer-events: auto;
}

.pet-minimize.minimized {
    color: #f3d36b;
}

.pet-member {
    left: 0px;
    width: 100px;
    height: 33px;
    background-color: #10151dcc;
    border-left-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-color: #4d493e;
    pointer-events: none;
}

.pet-name {
    left: 5px;
    top: 4px;
    width: 90px;
    height: 15px;
    color: #d0d0d0;
    font-size: 11px;
    line-height: 15px;
    overflow: hidden;
    white-space: nowrap;
}

.pet-hp-track {
    left: 5px;
    top: 23px;
    width: 89px;
    height: 6px;
    background-color: #231515;
    overflow: hidden;
}

.pet-hp,
.pet-hp-yellow {
    left: 0px;
    top: 0px;
    width: 0%;
    height: 6px;
}

.pet-hp {
    background-color: #b73e3e;
    z-index: 2;
}

.pet-hp-yellow {
    display: none;
    background-color: #d5b94a;
    z-index: 1;
}
